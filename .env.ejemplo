# Plantilla de secretos. Copia este archivo como ".env" en la carpeta de datos del bot
# (Mac: ~/Library/Application Support/BotTikTok/.env · Windows: %LOCALAPPDATA%\BotTikTok\.env).
# Nunca lo subas a git ni lo pegues en el código.

# Correo para alertas (SMTP). Con Gmail, usa una "contraseña de aplicación".
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=

# Contraseña del panel (http://127.0.0.1:8765): NO la escribas aquí. La primera vez que abres el panel te pide
# crearla y la guarda aquí cifrada (no se puede leer). Si la olvidas, borra esta línea y el panel pedirá una nueva.
PANEL_CONTRASENA=
